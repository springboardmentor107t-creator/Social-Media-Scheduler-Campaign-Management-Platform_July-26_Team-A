# ─────────────────────────────────────────────────────────────────────────────
# SocialPilot Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://socialpilot_user:CHANGE_ME_PASSWORD@localhost:5432/socialpilot_db

# Connection pool settings (defaults are fine for development; tune for production)
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_RECYCLE=1800
POSTGRES_CONNECT_TIMEOUT=5

# ── MongoDB (used for Notifications) ─────────────────────────────────────────
MONGODB_URL=mongodb://admin:CHANGE_ME_PASSWORD@localhost:27017/socialpilot_db?authSource=admin
MONGO_DB=socialpilot_db
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_PASSWORD@localhost:6379/0
REDIS_PASSWORD=CHANGE_ME_PASSWORD

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_256_bit_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Application ───────────────────────────────────────────────────────────────
# Set to "production" to enable strict CORS, hide error details, etc.
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (production only)
# Example: CORS_ORIGINS=https://socialpilot.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL — used by OAuth callbacks to redirect back after login.
FRONTEND_URL=http://localhost:5173

# ── YouTube OAuth ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_google_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# ── Facebook OAuth ────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
FACEBOOK_API_VERSION=v23.0
 
# ── Instagram OAuth (Reuses Facebook App) ──────────────────────────────────────
INSTAGRAM_APP_ID=your_facebook_app_id_here
INSTAGRAM_APP_SECRET=your_facebook_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/instagram/callback

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
